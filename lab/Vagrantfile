Vagrant.configure("2") do |config|
    if Vagrant.has_plugin?("vagrant-destroy-on-finish")
        config.destroy_on_finish.enabled = true
    end

    ## PRE-CONFIGURATIONS
    # Config for VirtualBox
    config.vm.provider "virtualbox" do |vb|
        vb.linked_clone = true
        vb.check_guest_additions = false
        vb.gui = false
    end

    # Generate RSA keys on the host before provisioning
    config.trigger.before :up do |trigger|
        trigger.name = "Generate RSA keys"
        trigger.run = { path: "./scripts/create_keys.sh" }
    end

    # We configure custom keys for the Vagrant main process and avoid re-adding new keys
    config.ssh.private_key_path = [
        "vagrant/id_rsa",
        "~/.vagrant.d/insecure_private_key"
    ]
    config.ssh.insert_key = false

    ## ZONE LIST
    zone_list = {
        external: "192.168.10",
        dmz: "192.168.20",
        trusted: "192.168.30",
        restricted: "192.168.40",
        management: "192.168.50"
    }

    ## SERVER LIST
    server_list = [
        { 
            name: "vagrant-ubuntu-1", 
            box: "cloud-image/ubuntu-22.04",
            networks: {
                dmz: "192.168.20.10",
                management: "192.168.50.10"
            },
            memory: "1024",
            cpus: 1
        },
        {
            name: "vagrant-ubuntu-2", 
            box: "cloud-image/ubuntu-24.04",
            networks: {
                dmz: "192.168.20.20",
                management: "192.168.50.11",
            },
            memory: "1024",
            cpus: 1
        },
        { 
            name: "vagrant-ubuntu-3",
            box: "cloud-image/ubuntu-26.04",
            networks: {
                dmz: "192.168.20.30",
                management: "192.168.50.12",
            },
            memory: "1024",
            cpus: 1
        },
        {
            name: "vagrant-rocky-1",
            box: "cloud-image/rocky-9",
            networks: {
                trusted: "192.168.30.10",
                management: "192.168.50.13",
            },
            memory: "768", 
            cpus: 1
        },
        {
            name: "vagrant-rocky-2",
            box: "cloud-image/rocky-9",
            networks: {
                trusted: "192.168.30.20",
                management: "192.168.50.14",
            },
            memory: "768", 
            cpus: 1
        },
        {
            name: "vagrant-rocky-3",
            box: "cloud-image/rocky-9",
            networks: {
                trusted: "192.168.30.30",
                management: "192.168.50.15",
            },
            memory: "768", 
            cpus: 1
        },
        {
            name: "vagrant-kali-1",
            box: "kalilinux/rolling",
            networks: {
                trusted: "192.168.30.40",
                management: "192.168.50.16",
            },
            memory: "2048", 
            cpus: 2
        },
        {
            name: "vagrant-postgresql-1",
            box: "cloud-image/rocky-9",
            public_ip: "192.168.40.10",
            networks: {
                restricted: "192.168.40.10",
                management: "192.168.50.17",
            },
            memory: "1536", 
            cpus: 2
        },
        {
            name: "vagrant-postgresql-2",
            box: "cloud-image/rocky-9",
            networks: {
                restricted: "192.168.40.20",
                management: "192.168.50.18",
            },
            memory: "1536", 
            cpus: 2
        },
        { 
            name: "vagrant-keycloak-1",
            box: "cloud-image/rocky-9",
            networks: {
                trusted: "192.168.40.50",
                management: "192.168.50.19",
            },
            memory: "2560", 
            cpus: 2
        },
        { 
            name: "vagrant-manager-1",
            box: "cloud-image/ubuntu-24.04",
            networks: {
                management: "192.168.50.254",
            },
            memory: "512", 
            cpus: 1
        },
    ]

    ## PLAYBOOK LIST - "path" refers to folder inside playbooks/
    playbook_list = [
        {
            name: "all",
            path: "groups"
        },
        {
            name: "dmz",
            path: "zones"
        },
        {
            name: "keycloak",
            path: "groups"
        },
        {
            name: "postgresql",
            path: "groups"
        },
        {
            name: "proxychains",
            path: "groups"
        }
    ]

    puts "\n─────────────────────────────────────"
    puts "  EasySec - Loading environment"
    puts "─────────────────────────────────────\n"

    server_list.each do |server|
        config.vm.define server[:name] do |vm|
            # ---- Host config ---- #
            vm.vm.box = server[:box]
            vm.vm.hostname = server[:name]
            vm.vm.boot_timeout = 600
            
            # Access key manipulation
            vm.vm.provision "file", run: "always",
                source: "vagrant/id_rsa.pub",
                destination: "/tmp/id_rsa.pub"

            vm.vm.provision "shell", run: "always", privileged: false, inline: <<-SCRIPT
                set -e
                mkdir -p ~/.ssh && chmod 700 ~/.ssh
                mv /tmp/id_rsa.pub ~/.ssh/id_rsa.pub
                touch ~/.ssh/authorized_keys
                grep -qF "$(cat ~/.ssh/id_rsa.pub)" ~/.ssh/authorized_keys || cat ~/.ssh/id_rsa.pub >> ~/.ssh/authorized_keys
                chmod 600 ~/.ssh/authorized_keys
                chmod 644 ~/.ssh/id_rsa.pub
            SCRIPT

            # Hardware manipulation
            vm.vm.provider "virtualbox" do |vb|
                vb.memory = server[:memory] if server[:memory]
                vb.cpus = server[:cpus] if server[:cpus]
            end

            server.fetch(:disks, []).each do |disk|
                vm.vm.disk :disk,
                    name: disk[:name],
                    size: disk[:size]
            end
            
            # Network segmentation
            server.fetch(:networks, []).each_with_index do |(zone, ip), index|
                is_kali = server[:box].include?("kalilinux")

                vm.vm.network "private_network",
                    ip: ip,
                    auto_config: !is_kali,
                    virtualbox__intnet: zone.to_s
                
                # Configures manually for Kali Linux
                if is_kali
                    iface = "eth#{index + 1}"

                    vm.vm.provision "shell", run: "always", inline: <<-SCRIPT
                        if nmcli -t -f NAME con show | grep -qx "#{zone}"; then
                            nmcli con modify "#{zone}" connection.interface-name #{iface} ipv4.method manual ipv4.addresses #{ip}/24 ipv6.method ignore
                        else
                            nmcli con add type ethernet ifname #{iface} con-name "#{zone}" ipv4.method manual ipv4.addresses #{ip}/24 ipv6.method ignore
                        fi

                        nmcli con up "#{zone}" || true
                    SCRIPT
                end
            end

            # Playbook execution + Private RSA provision
            if server[:name] == "vagrant-manager-1"
                # Sends the whole project (roles + playbooks) to manager
                vm.vm.synced_folder "..", "/vagrant", type: "rsync",
                    rsync__exclude: [".git/", ".vagrant/", ".venv/", "vault/"]

                vm.vm.provision "file", run: "always",
                    source: "vagrant/id_rsa",
                    destination: "/tmp/id_rsa"

                # Sends vault password to another path to avoid exposure
                vm.vm.provision "file", run: "always",
                    source: "vault/.vault_pass",
                    destination: "/tmp/.vault_pass"

                vm.vm.provision "shell", run: "always", privileged: false, inline: <<-SCRIPT
                    set -e
                    mv /tmp/.vault_pass ~/.vault_pass
                    chmod 600 ~/.vault_pass

                    mkdir -p ~/.ssh && chmod 700 ~/.ssh
                    mv /tmp/id_rsa ~/.ssh/id_rsa
                    chmod 600 ~/.ssh/id_rsa
                SCRIPT

                playbook_list.each do |task|
                    vm.vm.provision task[:name], type: "ansible_local", run: "never" do |ansible|
                        ansible.playbook = "playbooks/#{task[:path]}/#{task[:name]}.yml"
                        ansible.inventory_path = "inventory/hosts.yml"
                        ansible.provisioning_path = "/vagrant/lab"
                        ansible.limit = "all"
                        ansible.install_mode = "default"
                    end
                end
            end
        end
    end
end